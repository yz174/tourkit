{
  "name": "tourkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter='@tourkit/*' build",
    "typecheck": "bun run build && bun run --filter='@tourkit/*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "^2.29.9",
    "@types/bun": "^1.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
