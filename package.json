{
  "name": "tourkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter='@tourkit/*' build",
    "typecheck": "bun run build && bun run --filter='@tourkit/*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:dom": "bun run --filter='@tourkit/react' test:dom",
    "check:peers": "bun run scripts/check-peers.ts",
    "test:e2e": "bun run --filter='@tourkit/react' test:e2e",
    "playground": "bun run --filter='@tourkit/react' playground"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "^2.29.9",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
