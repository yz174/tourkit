{
  "name": "@tourkit/core",
  "version": "0.2.0",
  "description": "Platform-agnostic engine behind tourkit app tours.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js",
      "require": "./dist/dom/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@floating-ui/dom": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tour",
    "onboarding",
    "walkthrough",
    "product-tour",
    "spotlight",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yz174/tourkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yz174/tourkit#readme",
  "bugs": "https://github.com/yz174/tourkit/issues"
}
