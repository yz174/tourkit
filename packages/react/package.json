{
  "name": "@tourkit/react",
  "version": "0.0.0",
  "description": "DOM renderer for tourkit app tours.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unstyled": {
      "types": "./dist/unstyled.d.ts",
      "import": "./dist/unstyled.js",
      "require": "./dist/unstyled.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:dom": "vitest run",
    "e2e:build": "bun build ./e2e/fixture.tsx --outfile=./e2e/bundle.js --target=browser",
    "e2e:serve": "bun run ./e2e/serve.ts",
    "test:e2e": "bun run e2e:build && playwright test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tourkit/core": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.6",
    "vitest": "^4.1.11",
    "@tourkit/example-shared-tour": "0.0.0"
  }
}
