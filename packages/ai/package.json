{
  "name": "@tourkit/ai",
  "version": "0.1.0",
  "description": "Generate a tourkit tour from a user's question.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tourkit/core": "0.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@anthropic-ai/sdk": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@types/react": "19.2.18",
    "react": "19.2.8"
  },
  "keywords": [
    "ai",
    "tour",
    "onboarding",
    "anthropic",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yz174/tourkit.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/yz174/tourkit#readme",
  "bugs": "https://github.com/yz174/tourkit/issues"
}
