{
  "name": "@tourkit/cli",
  "version": "0.1.0",
  "description": "Scaffold tourkit into an existing app.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "tourkit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tourkit/ai": ">=0.0.0"
  },
  "peerDependenciesMeta": {
